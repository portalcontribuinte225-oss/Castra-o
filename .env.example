VITE_ADMIN_EMAIL=admin@castragestao.local
VITE_ADMIN_PASSWORD=troque-esta-senha
VITE_TUTOR_EMAIL=tutor@castragestao.local
VITE_TUTOR_PASSWORD=troque-esta-senha
VITE_GOOGLE_MAPS_API_KEY=sua-chave-google-maps

# Fallback opcional para WhatsApp Cloud API.
# Preferencialmente configure por município no painel Configurações > Ambiente > WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_CONFIRMATION=confirmacao_agenda_castracao
WHATSAPP_TEMPLATE_LANG=pt_BR

# Chave mestra usada para cifrar secrets salvos na tabela config (ex.: apiKey da IA externa).
# Obrigatória em produção — sem ela, a config de IA por município não pode ser lida/salva.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=
