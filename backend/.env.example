DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET=troque_por_uma_chave_secreta_forte
PORT=3001

# EmailJS (envio do código de redefinição de senha) — requer "Allow EmailJS API for
# non-browser applications" habilitado em Account > Security no dashboard EmailJS.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
